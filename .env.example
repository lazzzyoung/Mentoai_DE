# --- Database (내장 SQLite: 파일 경로만 지정) ---
SQLITE_PATH=data/mentoai.db

# --- Gemini ---
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3-flash-preview

# --- Embedding ---
# 전환은 CLI 한 방: mentoai switch-embedding --provider gemini --yes
# (자동으로 이 파일을 백업/갱신하고 임베딩 전량 재계산)
# EMBEDDING_PROVIDER=gemini: Gemini 임베딩 API (GOOGLE_API_KEY 사용)
# 참고: Go 버전은 Gemini API를 참조 구현으로 제공한다. 로컬 ONNX(fastembed) 등
# 다른 공급자는 internal/embedding의 Embedder 인터페이스 구현 후 레지스트리에 등록.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
EMBEDDING_CACHE_DIR=.models

# --- Scraping (Wanted) ---
WANTED_BASE_URL=https://www.wanted.co.kr
WANTED_JOB_GROUP_ID=518
WANTED_JOB_IDS=655
SCRAPE_MAX_ITEMS=120
SCRAPE_DELAY_SECONDS=0.4

# --- 배포 (Caddy 자동 HTTPS) ---
# localhost: 내부 CA 자체서명 인증서로 HTTPS(브라우저 경고 무시 필요)
# 실제 도메인: DNS를 서버에 맞추면 Let's Encrypt 인증서가 자동 발급·갱신된다
# (:80 평문으로 열려면 CADDY_DOMAIN=:80)
CADDY_DOMAIN=localhost

# --- Pipeline schedule (컨테이너에서는 SCHEDULE_ENABLED=true) ---
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 9,16 * * *
SCHEDULE_TIMEZONE=Asia/Seoul

# --- API ---
RECOMMEND_TOP_K=5

# --- 서버 시작 시 샘플 사용자 자동 적재 (컨테이너에서 true) ---
SEED_ON_START=false

# --- 로그인 (값이 채워진 공급자만 자동 활성화 — 비워 두면 기존처럼 무인증) ---
# 세션 서명 키: 로그인 기능의 마스터 스위치. `openssl rand -hex 32` 등으로 생성
AUTH_SECRET=
# true면 /api/v1/admin/* 와 /api/v1/jobs/* 에 로그인 강제
AUTH_REQUIRED=false
# HTTPS 뒤에서 운영할 때 true (쿠키 Secure 플래그)
AUTH_COOKIE_SECURE=false

# 구글 로그인: Google Cloud Console → OAuth 클라이언트(웹 애플리케이션) 생성 후 입력.
# 리다이렉트 URI에 아래 GOOGLE_REDIRECT_URL을 등록해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

# 앱인토스 로그인: 토스 콘솔에서 앱 등록 + mTLS 클라이언트 인증서 발급 후 경로 입력.
# 인가 코드는 클라이언트 SDK(appLogin)가 받아 POST /api/v1/auth/toss/callback 으로 전달된다.
# 참고: https://developers-apps-in-toss.toss.im/documentation/common/authentication/toss-login
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
