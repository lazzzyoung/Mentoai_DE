# --- Database (Postgres 17 + pgvector, compose 기본값) ---
DATABASE_URL=postgresql://mentoai:mentoai@localhost:5433/mentoai

# --- Gemini ---
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3-flash-preview

# --- Embedding ---
# 전환은 CLI 한 방: mentoai switch-embedding --provider gemini --yes
# (자동으로 이 파일을 백업/갱신하고 임베딩 테이블을 차원에 맞게 재생성 후 재임베딩)
# EMBEDDING_PROVIDER=fastembed: 로컬 ONNX (API 비용 0원, 모델 다운로드 최초 1회 약 2.2GB)
# EMBEDDING_PROVIDER=gemini:  Gemini 임베딩 API (모델 다운로드 없음, 기존 GOOGLE_API_KEY 사용)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
EMBEDDING_CACHE_DIR=.models

# --- Scraping (Wanted) ---
WANTED_BASE_URL=https://www.wanted.co.kr
WANTED_JOB_GROUP_ID=518
WANTED_JOB_IDS=655
SCRAPE_MAX_ITEMS=120
SCRAPE_DELAY_SECONDS=0.4

# --- Pipeline schedule (컨테이너에서는 SCHEDULE_ENABLED=true) ---
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 9,16 * * *
SCHEDULE_TIMEZONE=Asia/Seoul

# --- API ---
RECOMMEND_TOP_K=5
