FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/mentoai ./cmd/mentoai

FROM caddy:2
COPY --from=build /out/mentoai /usr/bin/mentoai
COPY /tmp/Caddyfile.single /etc/caddy/Caddyfile
COPY /tmp/start-single.sh /start.sh
RUN chmod +x /start.sh
ENV SQLITE_PATH=/data/mentoai.db SEED_ON_START=true
VOLUME /data
EXPOSE 80 443
ENTRYPOINT ["/start.sh"]
